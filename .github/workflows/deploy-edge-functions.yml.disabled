name: Deploy Edge Functions to Supabase

on:
  push:
    branches: [main]
    paths:
      - 'supabase/functions/**'
      - '.github/workflows/deploy-edge-functions.yml'
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      SUPABASE_PROJECT_ID: rjcruiwlurqdwooarrpa

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Supabase CLI
        uses: supabase/setup-cli@v1
        with:
          version: latest

      - name: Validate Supabase access token
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          SB_ACCESS_TOKEN: ${{ secrets.SB_ACCESS_TOKEN }}
        run: |
          if [ -z "$SUPABASE_ACCESS_TOKEN" ] && [ -z "$SB_ACCESS_TOKEN" ]; then
            echo "::error::Nenhum token do Supabase encontrado."
            echo "::error::Adicione o secret SUPABASE_ACCESS_TOKEN (ou SB_ACCESS_TOKEN) em:"
            echo "::error::GitHub > Settings > Secrets and variables > Actions > New repository secret"
            exit 1
          fi
          if [ -n "$SUPABASE_ACCESS_TOKEN" ]; then
            echo "Token SUPABASE_ACCESS_TOKEN encontrado."
          else
            echo "Token SB_ACCESS_TOKEN encontrado."
          fi

      - name: Deploy Edge Functions
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN || secrets.SB_ACCESS_TOKEN }}
        run: |
          supabase link --project-ref $SUPABASE_PROJECT_ID
          supabase functions deploy mercado-pago
          supabase functions deploy assinaturas
          echo "Edge Functions deployadas com sucesso."
